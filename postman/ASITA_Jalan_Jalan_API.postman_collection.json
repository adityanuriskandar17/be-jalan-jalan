								"method": "GET",
								"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
								"url": "{{base_url}}/admin/bookings/1"
							}
						},
						{
							"name": "View E-Ticket",
							"request": {
								"method": "GET",
