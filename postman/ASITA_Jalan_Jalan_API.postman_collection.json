								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"destination_id\": 1,\n  \"visitor_name\": \"Walk-in Guest\",\n  \"visitor_email\": \"walkin@guest.com\",\n  \"visitor_phone\": \"081234567890\",\n  \"visit_date\": \"2026-02-20\",\n  \"items\": [\n      { \"ticket_id\": 1, \"quantity\": 2 }\n  ],\n  \"payment_method\": \"CASH\",\n  \"status\": \"CONFIRMED\",\n  \"payment_status\": \"PAID\"\n}"
								},
								"url": "{{base_url}}/admin/bookings"
