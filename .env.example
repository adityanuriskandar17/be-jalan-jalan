# Postgres SQL
DB_HOST=localhost 
DB_PORT=5432 
DB_USER=bosani 
DB_PASSWORD=1234567890
DB_NAME=astpay_jalan

# JWT
JWT_SECRET=supersecretkey_change_me_in_production
JWT_EXPIRATION_HOURS=24

# ========================================
# SMTP Email Configuration
# ========================================
# Untuk Gmail:
# 1. Enable 2-Factor Authentication di Google Account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Gunakan App Password sebagai SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=noreply@asita-jalan.com
SMTP_FROM_NAME=ASITA - Jalan Jalan

# ========================================
# WhatsApp OTP Configuration
# ========================================
WA_API_TOKEN=your-wa-api-token
WA_API_SECRET=your-wa-api-secret
WA_URL_INVOICE="https://apiwa.asitatech.co.id/api/sendMessageText"

# ========================================
# SMS Configuration (GoSMSGateway Masking API)
# ========================================
SMS_BASE_URL=https://secure.gosmsgateway.com/masking/api/sendsms.php
SMS_USERNAME=your-username
SMS_PASSWORD=your-password

# ========================================
# NOTES:
# ========================================
# 1. Copy file ini menjadi .env dan isi dengan kredensial yang valid
# 2. Jangan commit file .env ke git repository
# 3. Untuk testing, bisa gunakan email dan nomor telepon sendiri
# 4. GoSMSGateway memerlukan top up balance untuk WhatsApp & SMS
